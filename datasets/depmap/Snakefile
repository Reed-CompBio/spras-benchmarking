include: "../../cache/Snakefile"

rule all:
    input:
        # "raw/phosphosite-irefindex13.0-uniprot.txt" # TODO: update this to String v12
        "processed/A375_SKIN/input_nodes.csv",
        "processed/interactome.tsv",
        "processed/empty_data_no_cna.csv",
        "processed/empty_data.csv",
        "processed/A375_SKIN/gold_standard.csv",
        # "processed/empty_gold_standard.csv", # this keeps being made and then deleted

produce_fetch_rules({

    # depmap data
    "raw/OmicsProfiles_25Q3.csv": ("DepMap_25Q3", "OmicsProfiles_25Q3.csv"),
    "raw/Model_25Q3.csv": ("DepMap_25Q3", "Model_25Q3.csv"),
    "raw/CRISPRGeneDependency_25Q3.csv": ("DepMap_25Q3", "CRISPRGeneDependency_25Q3.csv"),
    "raw/OmicsSomaticMutationsMatrixDamaging_25Q3.csv": ("DepMap_25Q3", "OmicsSomaticMutationsMatrixDamaging_25Q3.csv"),

    # cbioportal data
    "raw/Cell_lines_annotations_20181226_ccle2019.txt" : ("CCLE_2019", "Cell_lines_annotations_20181226_ccle2019.txt"),
    "raw/data_cna_cbioportal_ccle2019.txt": ("cbioportal", "data_cna_cbioportal_ccle2019.txt"),

    # tfa data
    "raw/consensus_tfa_march_6.tsv": ("estimateNCA", "consensus_tfa_march_6.tsv"),
    "raw/tfs_beyond_2sd_per_cell_line.csv": ("estimateNCA", "tfs_beyond_2sd_per_cell_line.csv"),

    "raw/shared_cell_lines_may_12.txt": ("cancer_cellline_misc", "shared_cell_lines_may_12.txt"),

    "raw/9606.protein.physical.links.full.txt": FetchConfig(("STRING", "v12", "9606", "9606.protein.physical.links.v12.0.txt.gz"), post_process=PostProcessAction.UNCOMPRESS_GZ),
    "raw/9606.protein.aliases.txt": FetchConfig(("STRING",  "v12", "9606", "9606.protein.aliases.txt.gz"), post_process=PostProcessAction.UNCOMPRESS_GZ),

})

rule interactome: 
    input:
        "raw/9606.protein.physical.links.full.txt", 
        "raw/9606.protein.aliases.txt"
    output:
        "processed/interactome.tsv",
    shell:
        "uv run scripts/process_interactome.py"

rule input_nodes: 
    input:
        "raw/OmicsSomaticMutationsMatrixDamaging_25Q3.csv",
        "raw/data_cna_cbioportal_ccle2019.txt",
        "raw/consensus_tfa_march_6.tsv",
        "raw/tfs_beyond_2sd_per_cell_line.csv",
        "raw/shared_cell_lines_may_12.txt",
        "raw/9606.protein.aliases.txt",
        "processed/interactome.tsv",
    output:
        "processed/A375_SKIN/input_nodes.csv",
        "processed/empty_data_no_cna.csv",
        "processed/empty_data.csv",

    shell:
        "uv run scripts/process_input_nodes.py"

rule gold_standard: 
    input:
        "raw/CRISPRGeneDependency_25Q3.csv", # gold standard data
        "processed/interactome.tsv", # interactome to trim with
        "raw/9606.protein.aliases.txt", # id mapping HGNC -> ENSP
        "raw/shared_cell_lines_may_12.txt", # lines to use
        "processed/empty_data_no_cna.csv", # lines to avoid
        "processed/empty_data.csv", # lines to avoid
    output:
        "processed/A375_SKIN/gold_standard.csv",
        # "processed/empty_gold_standard.csv",
    shell:
        "uv run scripts/process_gold_standard.py"