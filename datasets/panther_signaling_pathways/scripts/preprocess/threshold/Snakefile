from pathlib import Path
import urllib.parse
from jsonc_parser.parser import JsoncParser

panther_directory = Path("..") / ".." / ".."
intermediate_directory = panther_directory / "intermediate"
processed_directory = panther_directory / "processed"

thresholds = [50]
# TODO update to the full list after I know this works
# thresholds = list(map(str, map(lambda x: (x + 1) / 10, range(10))))

def make_file_safe(input_str: str) -> str:
    return urllib.parse.quote(input_str, safe='')


pathways = JsoncParser.parse_file(str(panther_directory / "pathways.jsonc"))
file_compatible_pathways = list(map(make_file_safe, pathways))


rule all:
    input:
        expand(
            str(processed_directory / "{pathway}" / "interactomes" / "interactome_{threshold}.txt"),
            pathway=file_compatible_pathways,
            threshold=thresholds,
        )


rule threshold:
    input:
        input_nodes=str(intermediate_directory / "{pathway}" / "input_nodes.csv"),
        pathway=str(intermediate_directory / "{pathway}" / "pathway.csv"),
        interactome=str(processed_directory / "interactome.tsv"),
        weight_counts=str(processed_directory / "weight-counts.tsv"),
    output:
        str(processed_directory / "{pathway}" / "interactomes" / "interactome_{threshold}.txt")
    shell:
        'uv run threshold.py "{wildcards.pathway}" --threshold "{wildcards.threshold}"'