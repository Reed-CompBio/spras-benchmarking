produce_fetch_rules({
    # Instead of going through https://unmtid-shinyapps.net/shiny/tiga/, we use their
    # archived files directory instead.
    "raw/tiga_gene-trait_stats.tsv": CacheItem(
        name="TIGA data",
        cached="https://drive.google.com/uc?id=114qyuNDy4qdmYDHHJAW-yBeTxcGTDUnK",
        pinned="https://unmtid-dbs.net/download/TIGA/20250916/tiga_gene-trait_stats.tsv",
    ),

    "raw/human_disease_textmining_full.tsv": FetchConfig(
        CacheItem(
            name="DISEASES textmining channel gunzipped",
            cached="https://drive.google.com/uc?id=1JEFfYzRtxZTn0518anm1oPKWAFK1pUNC",
            unpinned="https://download.jensenlab.org/human_disease_textmining_full.tsv",
        ), 
        post_process=PostProcessAction.UNCOMPRESS_GZ
    ),

    "raw/human_disease_knowledge_full.tsv": CacheItem(
        name="DISEASES knowledge channel",
        cached="https://drive.google.com/uc?id=1o9hHDfP-Orb78oBWzU41SrDKyj39GlCB",
        unpinned="https://download.jensenlab.org/human_disease_knowledge_full.tsv",
    ),


    "raw/9606.protein.links.full.txt": FetchConfig(
        ("STRING", "v12", "9606", "9606.protein.links.full.txt.gz"), 
        post_process=PostProcessAction.UNCOMPRESS_GZ
    ),

    "raw/9606.protein.aliases.txt": FetchConfig(
        ("STRING", "v12", "9606", "9606.protein.aliases.txt.gz"),
        post_process=PostProcessAction.UNCOMPRESS_GZ
    ),
})

rule gold_standard:
    input:
        "raw/human_disease_knowledge_full.tsv",
        "raw/human_disease_textmining_full.tsv"
    output:
        "processed/gold_standard.csv"
    shell:
        "uv run scripts/prepare_gold_standard.py"

rule trait_gene_assoc:
    input:
        "processed/gold_standard.csv",
        "raw/tiga_gene-trait_stats.tsv",
        "raw/9606.protein.aliases.txt"
    output:
        "processed/trait_gene_assoc.csv"
    shell:
        "uv run scripts/trait_gene_assoc.py"

