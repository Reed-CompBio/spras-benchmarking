 <bp:standardName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Fructose-bisphosphate aldolase C</bp:standardName>
 <bp:xref rdf:resource="http://pathwaycommons.org/pc12/UnificationXref_uniprot_knowledgebase_P09972" />
 <bp:xref rdf:resource="http://pathwaycommons.org/pc12/RelationshipXref_hgnc_symbol_ALDOC_identity" />
 <bp:organism rdf:resource="http://identifiers.org/taxonomy/9606" />
 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">ALDOC_HUMAN</bp:displayName>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">ALDC</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Brain-type aldolase</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">ALDOC</bp:name>
