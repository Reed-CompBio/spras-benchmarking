 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Short-chain dehydrogenase/reductase family 4E member 1</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">SDR4E1</bp:name>
