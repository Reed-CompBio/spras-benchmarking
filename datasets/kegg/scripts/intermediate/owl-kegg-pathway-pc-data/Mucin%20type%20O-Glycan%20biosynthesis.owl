 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">SIA4A_HUMAN Reviewed; 340 AA.</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://mirtarbase.mbc.nctu.edu.tw/#ref_6482</bp:comment>
