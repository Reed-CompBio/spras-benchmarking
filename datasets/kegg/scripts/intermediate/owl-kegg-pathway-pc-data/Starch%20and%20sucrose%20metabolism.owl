<bp:ProteinReference rdf:about="http://identifiers.org/uniprot/P34949">
 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_faf69a91b79cfe54c0bb60ec9a419ea1" />
