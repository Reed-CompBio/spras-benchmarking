 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">UGPA_HUMAN</bp:displayName>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">UDP-glucose pyrophosphorylase</bp:name>
