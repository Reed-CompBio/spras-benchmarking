 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">RDHE2</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">SDR16C5</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Retinal short-chain dehydrogenase reductase 2</bp:name>
