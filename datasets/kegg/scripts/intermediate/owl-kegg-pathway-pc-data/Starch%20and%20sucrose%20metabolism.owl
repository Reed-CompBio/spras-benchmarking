 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_6bfc2dc67ba84885e31d3e27877b25a6" />
 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_356c4dc7b89e8017389910c2cf80535d" />
 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_de61ce3858261e733008660ce52ad97c" />
 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_1c7741fb8e379a0d3e0aeef8fd889911" />
