 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Processed beta-1,4-galactosyltransferase 1</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Beta-1,4-GalTase 1</bp:name>
