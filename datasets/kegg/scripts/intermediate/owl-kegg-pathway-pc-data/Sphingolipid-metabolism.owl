 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://www.humanmetabolism.org/#ref_http://www.humanmetabolism.org/#protein_SPTLC1</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">SPTC1_HUMAN Reviewed; 473 AA.</bp:comment>
</bp:ProteinReference>

