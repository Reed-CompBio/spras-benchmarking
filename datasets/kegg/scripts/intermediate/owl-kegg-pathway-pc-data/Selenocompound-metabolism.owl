 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Liver-pancreas antigen</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">TRNP48</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Soluble liver antigen</bp:name>
