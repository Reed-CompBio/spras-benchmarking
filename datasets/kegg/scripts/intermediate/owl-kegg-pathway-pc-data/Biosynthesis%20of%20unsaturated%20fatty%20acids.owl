 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Arachidonate--CoA ligase</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">6.2.1.15</bp:name>
