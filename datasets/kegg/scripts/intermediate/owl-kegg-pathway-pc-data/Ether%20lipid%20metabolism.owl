 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_1246de130ffd3e39c9c898bbc1de258f" />
 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_95f6bd2727b2b008b3f61bea0a44ca29" />
