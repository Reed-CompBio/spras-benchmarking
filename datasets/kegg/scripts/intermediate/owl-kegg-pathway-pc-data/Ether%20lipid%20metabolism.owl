 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Phosphatidylinositol-glycan biosynthesis class M protein</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">GPI mannosyltransferase I</bp:name>
