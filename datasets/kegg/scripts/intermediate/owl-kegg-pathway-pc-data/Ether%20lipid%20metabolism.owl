 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Long-chain fatty-acyl elongase</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">hELO2</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">ELOVL fatty acid elongase 6</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">ELOVL FA elongase 6</bp:name>
