 <bp:standardName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Short-chain specific acyl-CoA dehydrogenase, mitochondrial</bp:standardName>
 <bp:xref rdf:resource="http://pathwaycommons.org/pc12/RelationshipXref_hgnc_symbol_ACADS_identity" />
 <bp:xref rdf:resource="http://pathwaycommons.org/pc12/UnificationXref_uniprot_knowledgebase_P16219" />
 <bp:organism rdf:resource="http://identifiers.org/taxonomy/9606" />
 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">ACADS_HUMAN</bp:displayName>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">SCAD</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">1.3.8.1</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Butyryl-CoA dehydrogenase</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">ACADS</bp:name>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://pathwaycommons.org/pc12/ProteinReference_uniprotkb_P16219_identity</bp:comment>
