<bp:ProteinReference rdf:about="http://identifiers.org/uniprot/P10515">
 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_c838cb42cab68ef53f8dd84d477e691c" />
 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_150d204d49be19f869fe408934acbd8f" />
 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_a87eec7859a6e63029316c1ec33b8e4f" />
