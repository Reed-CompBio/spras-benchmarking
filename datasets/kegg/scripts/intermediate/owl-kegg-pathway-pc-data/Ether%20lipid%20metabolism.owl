 <bp:standardName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">S-acyl fatty acid synthase thioesterase, medium chain</bp:standardName>
 <bp:xref rdf:resource="http://pathwaycommons.org/pc12/RelationshipXref_hgnc_symbol_OLAH_identity" />
 <bp:xref rdf:resource="http://pathwaycommons.org/pc12/UnificationXref_uniprot_knowledgebase_Q9NV23" />
