 <bp:standardName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Elongation of very long chain fatty acids protein 6</bp:standardName>
 <bp:xref rdf:resource="http://pathwaycommons.org/pc12/RelationshipXref_hgnc_symbol_ELOVL6_identity" />
