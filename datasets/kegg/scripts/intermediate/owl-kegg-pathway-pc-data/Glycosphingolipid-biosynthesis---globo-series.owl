 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">SIATFL</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Beta-galactoside alpha-2,3-sialyltransferase 1</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">SIAT4-A</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Gal-NAc6S</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">SIAT4A</bp:name>
