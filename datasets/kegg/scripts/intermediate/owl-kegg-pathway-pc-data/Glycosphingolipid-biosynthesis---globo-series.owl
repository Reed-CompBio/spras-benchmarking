 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Beta-1,3-GalTase 5</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">B3GALT5</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">b3Gal-T5</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Beta3Gal-T5</bp:name>
