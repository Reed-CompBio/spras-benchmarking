 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Gal-beta-1,3-GalNAc-alpha-2,3-sialyltransferase</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">ST3O</bp:name>
