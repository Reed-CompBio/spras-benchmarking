 <bp:organism rdf:resource="http://identifiers.org/taxonomy/9606" />
 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">SIA4A_HUMAN</bp:displayName>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">ST3Gal I</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">2.4.99.4</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">ST3GalI</bp:name>
