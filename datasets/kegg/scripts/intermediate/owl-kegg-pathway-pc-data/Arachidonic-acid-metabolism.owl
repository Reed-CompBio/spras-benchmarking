 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">GGT5_HUMAN</bp:displayName>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">GGT5</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Gamma-glutamyltransferase 5</bp:name>
