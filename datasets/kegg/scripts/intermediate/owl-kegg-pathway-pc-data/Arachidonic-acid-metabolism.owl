 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Gamma-glutamyltransferase-like activity 1</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Leukotriene-C4 hydrolase</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Gamma-glutamyl transpeptidase-related enzyme</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">GGT-rel</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">3.4.19.13</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">3.4.19.14</bp:name>
