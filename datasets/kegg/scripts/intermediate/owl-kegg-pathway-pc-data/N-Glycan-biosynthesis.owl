 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">AK1BA_HUMAN</bp:displayName>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">1.1.1.54</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">ARL-1</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">hARP</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Aldose reductase-related protein</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Small intestine reductase</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">AKR1B11</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">AKR1B10</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">SI reductase</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">1.1.1.300</bp:name>
