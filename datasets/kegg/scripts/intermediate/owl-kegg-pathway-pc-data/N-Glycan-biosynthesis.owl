 <bp:standardName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Aldo-keto reductase family 1 member B10</bp:standardName>
 <bp:xref rdf:resource="http://pathwaycommons.org/pc12/RelationshipXref_hgnc_symbol_AKR1B10_identity" />
 <bp:xref rdf:resource="http://pathwaycommons.org/pc12/UnificationXref_uniprot_knowledgebase_O60218" />
