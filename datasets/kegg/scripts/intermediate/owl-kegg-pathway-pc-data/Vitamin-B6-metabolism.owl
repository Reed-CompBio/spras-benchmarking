<bp:Protein rdf:about="http://pathwaycommons.org/pc12/Protein_e10b3e82c6d0255e0d1bc362fbabd826">
 <bp:standardName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">PNPO, FLJ10535, PDXPO</bp:standardName>
 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">PNPO</bp:displayName>
 <bp:entityReference rdf:resource="http://identifiers.org/uniprot/Q9NVS9" />
