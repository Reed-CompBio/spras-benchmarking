 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">11beta,21-Dihydroxy-3,20-dioxo-4-pregnen-18-al</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Aldosterone</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">(+)-aldosterone</bp:name>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">is_a CHEBI:131565</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">is_a CHEBI:25354</bp:comment>
