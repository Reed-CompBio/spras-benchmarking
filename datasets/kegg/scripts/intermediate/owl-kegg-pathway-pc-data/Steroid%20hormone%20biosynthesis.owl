 <bp:organism rdf:resource="http://identifiers.org/taxonomy/9606" />
 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">CP7A1_HUMAN</bp:displayName>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">1.14.14.26</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">24-hydroxycholesterol 7-alpha-hydroxylase</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">CYP7</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Cholesterol 7-alpha-monooxygenase</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Cholesterol 7-alpha-hydroxylase</bp:name>
