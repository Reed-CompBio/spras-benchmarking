 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">aldosterone</bp:displayName>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">CHEBI:27584</bp:name>
