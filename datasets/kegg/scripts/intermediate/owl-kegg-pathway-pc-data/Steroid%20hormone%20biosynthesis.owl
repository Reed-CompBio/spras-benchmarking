 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">CYAR</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Cytochrome P450 19A1</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Estrogen synthase</bp:name>
