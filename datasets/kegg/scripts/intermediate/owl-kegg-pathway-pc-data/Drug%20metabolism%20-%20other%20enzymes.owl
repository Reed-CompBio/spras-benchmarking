 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">(1-(5-Deoxy-beta-D-ribofuranosyl)-5-fluoro-1,2-dihydro-2-oxo-4-pyrimidinyl)-carbamic acid pentyl ester</bp:name>
