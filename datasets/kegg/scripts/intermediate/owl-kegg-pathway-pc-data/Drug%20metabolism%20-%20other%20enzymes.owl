 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">irinotecan</bp:displayName>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Irinophore C</bp:name>
