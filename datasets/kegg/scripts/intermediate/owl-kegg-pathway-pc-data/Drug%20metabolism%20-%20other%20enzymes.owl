<bp:SmallMolecule rdf:about="http://pathwaycommons.org/pc12/SmallMolecule_eccaea91069d063ccc20137dafdcbc22">
 <bp:standardName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">C16614</bp:standardName>
