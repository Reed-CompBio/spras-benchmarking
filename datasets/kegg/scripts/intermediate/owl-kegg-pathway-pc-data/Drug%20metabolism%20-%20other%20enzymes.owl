 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">CHEBI:80630</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Irinotecan mylan</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">HSDB 7607</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">irinotecanum</bp:name>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">has_functional_parent CHEBI:8988</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">has_role CHEBI:35610</bp:comment>
