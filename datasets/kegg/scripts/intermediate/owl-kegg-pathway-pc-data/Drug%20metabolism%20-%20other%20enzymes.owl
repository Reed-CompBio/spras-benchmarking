 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">5-fluoropyrimidine-2,4(1H,3H)-dione</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">fluorouracil</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">fluorouracilum</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Fluorouracil</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">5-FU</bp:name>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">is_a CHEBI:37143</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://www.drugbank.ca/#ref_DB00544</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">has_role CHEBI:35610</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">has_role CHEBI:132992</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">is_a CHEBI:67142</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">has_functional_parent CHEBI:17568</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://www.ra.cs.uni-tuebingen.de/software/KEGGtranslator/drD00584_cpdC07649.eref</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">has_role CHEBI:35703</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">has_role CHEBI:35705</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">has_role CHEBI:78298</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">A nucleobase analogue that is uracil in which the hydrogen at position 5 is replaced by fluorine. It is an antineoplastic agent which acts as an antimetabolite - following conversion to the active deoxynucleotide, it inhibits DNA synthesis (by blocking the conversion of deoxyuridylic acid to thymidylic acid by the cellular enzyme thymidylate synthetase) and so slows tumour growth.</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">has_role CHEBI:35221</bp:comment>
</bp:SmallMoleculeReference>

