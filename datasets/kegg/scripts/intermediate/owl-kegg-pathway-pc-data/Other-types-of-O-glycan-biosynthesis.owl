 <bp:standardName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Alpha-1,6-mannosylglycoprotein 6-beta-N-acetylglucosaminyltransferase B</bp:standardName>
 <bp:xref rdf:resource="http://pathwaycommons.org/pc12/RelationshipXref_hgnc_symbol_MGAT5B_identity" />
