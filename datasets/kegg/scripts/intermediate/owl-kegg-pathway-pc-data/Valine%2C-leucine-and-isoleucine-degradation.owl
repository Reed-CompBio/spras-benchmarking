 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_94e7154da4f6ceb2e3b77ecfd89f9e99" />
 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_5700182968ac7518b3ae80869025f4c7" />
