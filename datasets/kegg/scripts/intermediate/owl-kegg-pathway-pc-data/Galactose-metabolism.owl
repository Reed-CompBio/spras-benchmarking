 <bp:standardName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Sorbitol dehydrogenase</bp:standardName>
 <bp:xref rdf:resource="http://pathwaycommons.org/pc12/RelationshipXref_hgnc_symbol_SORD_identity" />
