 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">lactose</bp:displayName>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">D-lactose</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">lactobiose</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">beta-D-Galp-(1-&gt;4)-D-Glcp</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Laktobiose</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">beta-D-Gal-(1-&gt;4)-D-Glc</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">milk sugar</bp:name>
