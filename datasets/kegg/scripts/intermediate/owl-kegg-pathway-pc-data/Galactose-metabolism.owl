 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">is_a CHEBI:24405</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://pathwaycommons.org/pc12/SmallMoleculeReference_bind_1104_identity</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://www.ra.cs.uni-tuebingen.de/software/KEGGtranslator/cpdC00243.eref</bp:comment>
</bp:SmallMoleculeReference>

