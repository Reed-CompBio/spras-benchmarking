 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">4-O-beta-D-galactopyranosyl-D-glucose</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">1-beta-D-Galactopyranosyl-4-D-glucopyranose</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Lac</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">beta-Gal1,4-Glc</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Milchzucker</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">(Gal)1 (Glc)1</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">(+)-lactose</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Milk sugar</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Laktose</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Galbeta1-4Glc</bp:name>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">A glycosylglucose disaccharide, found most notably in milk, that consists of D-galactose and D-glucose fragments bonded through a beta-1-&gt;4 glycosidic linkage. The glucose fragment can be in either the alpha- or beta-pyranose form, whereas the galactose fragment can only have the beta-pyranose form.</bp:comment>
