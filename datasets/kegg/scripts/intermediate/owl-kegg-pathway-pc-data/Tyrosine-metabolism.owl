 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_b65f43e716c73591070f697eb0f7d6d7" />
 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_2cb6b990622bfdac8b82c255cd98b3bb" />
