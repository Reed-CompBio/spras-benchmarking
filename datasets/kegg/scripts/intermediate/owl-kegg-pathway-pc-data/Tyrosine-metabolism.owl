 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">AATM_HUMAN</bp:displayName>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">FABPpm</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">2.6.1.7</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Glutamate oxaloacetate transaminase 2</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">2.6.1.1</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">GOT2</bp:name>
