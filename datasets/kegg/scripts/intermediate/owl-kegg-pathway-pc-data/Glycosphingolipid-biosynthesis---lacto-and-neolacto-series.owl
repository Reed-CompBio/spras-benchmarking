 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">CMP-NeuAc:beta-galactoside alpha-2,3-sialyltransferase VI</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">ST3GalVI</bp:name>
