 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">N-acetyllactosaminide alpha-2,3-sialyltransferase</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Gal beta-1,3(4) GlcNAc alpha-2,3 sialyltransferase</bp:name>
