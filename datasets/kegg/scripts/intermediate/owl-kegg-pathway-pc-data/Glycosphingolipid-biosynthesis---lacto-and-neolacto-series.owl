 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">ST3GAL6</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">SIAT10</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">2.4.99.-</bp:name>
