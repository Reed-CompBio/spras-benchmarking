<bp:ProteinReference rdf:about="http://identifiers.org/uniprot/Q9Y2Y1">
 <bp:standardName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">DNA-directed RNA polymerase III subunit RPC10</bp:standardName>
 <bp:xref rdf:resource="http://pathwaycommons.org/pc12/UnificationXref_uniprot_knowledgebase_Q9Y2Y1" />
