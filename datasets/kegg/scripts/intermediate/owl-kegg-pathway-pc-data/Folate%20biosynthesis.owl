 <bp:organism rdf:resource="http://identifiers.org/taxonomy/9606" />
 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">RPIA_HUMAN</bp:displayName>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">RPIA</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">5.3.1.6</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">RPI</bp:name>
