 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">3.1.1.31</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">6-phosphogluconolactonase</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">6PGL</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Glucose-6-phosphate dehydrogenase</bp:name>
