 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">G6PD_HUMAN</bp:displayName>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">G6PD</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">1.1.1.49</bp:name>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://pathwaycommons.org/pc12/ProteinReference_HPRD_02377_identity</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://www.ctdbase.org/#ref_protein_gene_2539</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://www.phosphosite.org/phosphosite.owl#po_2828402</bp:comment>
