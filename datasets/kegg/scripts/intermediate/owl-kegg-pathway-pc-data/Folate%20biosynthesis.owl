 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Formylglycinamide ribonucleotide amidotransferase</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">FGAMS</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">PFAS</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">FGAR amidotransferase</bp:name>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://identifiers.org/uniprot/A8K9T9</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">PUR4_HUMAN Reviewed; 1338 AA.</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://identifiers.org/refseq/NP_036525</bp:comment>
