 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">1-deoxy-1-(7,8-dimethyl-2,4-dioxo-3,4-dihydrobenzo[g]pteridin-10(2H)-yl)pentitol</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">riboflavina</bp:name>
