 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">PUR4_HUMAN</bp:displayName>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">6.3.5.3</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">FGAR-AT</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">KIAA0361</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Formylglycinamide ribotide amidotransferase</bp:name>
