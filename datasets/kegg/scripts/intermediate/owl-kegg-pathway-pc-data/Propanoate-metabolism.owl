 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">1.2.1.8</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Antiquitin-1</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">ATQ1</bp:name>
