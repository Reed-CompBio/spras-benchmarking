 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">GABA-AT</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Gamma-amino-N-butyrate transaminase</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">GABA aminotransferase</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">2.6.1.19</bp:name>
