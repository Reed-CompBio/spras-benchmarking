 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">ALDR_HUMAN</bp:displayName>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">1.1.1.372</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">AR</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">1.1.1.54</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">1.1.1.21</bp:name>
