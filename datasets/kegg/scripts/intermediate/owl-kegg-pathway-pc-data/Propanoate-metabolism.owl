 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">2.1.3.3</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">OTCase</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Ornithine transcarbamylase</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">OTC</bp:name>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://identifiers.org/refseq/NP_000522</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://pathwaycommons.org/pc12/ProteinReference_rcsb_pdb_1EP9_see-also</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://pathwaycommons.org/pc12/ProteinReference_HPRD_08947_identity</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://pathwaycommons.org/pc12/ProteinReference_rcsb_pdb_1C9Y_see-also</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://www.ctdbase.org/#ref_protein_gene_5009</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://biocyc.org/biopax/biopax-level3ProteinReference89090</bp:comment>
