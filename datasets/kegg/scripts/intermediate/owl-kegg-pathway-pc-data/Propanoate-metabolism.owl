 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">PAPS2_HUMAN</bp:displayName>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">2.7.1.25</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Sulfurylase kinase 2</bp:name>
