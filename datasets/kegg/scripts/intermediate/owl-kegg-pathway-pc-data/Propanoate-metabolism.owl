 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">PYR1_HUMAN Reviewed; 2225 AA.</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://mirtarbase.mbc.nctu.edu.tw/#ref_790</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://pathwaycommons.org/pc12/ProteinReference_dip_DIP-39484N_identity</bp:comment>
</bp:ProteinReference>

