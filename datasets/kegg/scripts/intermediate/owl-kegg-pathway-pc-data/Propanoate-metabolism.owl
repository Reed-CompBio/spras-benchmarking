 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_7112b27b2f54027e1f9b6c25496e2b9a" />
 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_5c0eb761792fb6de080930248e00b0e7" />
 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_6920e49fbaafc620256fc7bd68e64194" />
 <bp:standardName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Malonyl-CoA-acyl carrier protein transacylase, mitochondrial</bp:standardName>
 <bp:xref rdf:resource="http://pathwaycommons.org/pc12/RelationshipXref_hgnc_symbol_MCAT_identity" />
