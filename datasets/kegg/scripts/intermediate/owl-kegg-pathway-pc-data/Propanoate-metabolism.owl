 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Brain-type aldolase</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">ALDOC</bp:name>
