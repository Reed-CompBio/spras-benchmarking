 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">ATP-grasp domain-containing protein 1</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">CARNS1</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">ATPGD1</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">6.3.2.11</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">KIAA1394</bp:name>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://identifiers.org/refseq/XP_005274182</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">CRNS1_HUMAN Reviewed; 827 AA.</bp:comment>
