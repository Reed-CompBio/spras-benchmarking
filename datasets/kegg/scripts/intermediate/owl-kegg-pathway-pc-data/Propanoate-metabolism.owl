 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_fef503ce1506ca496aec72faa3439b7f" />
 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_aacc9fd8f5cd5e0c2bf37470e346ed9e" />
