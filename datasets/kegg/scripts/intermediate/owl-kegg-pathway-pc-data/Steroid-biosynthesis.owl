 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">SOAT1_HUMAN Reviewed; 550 AA.</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://pathwaycommons.org/pc12/ProteinReference_uniprotkb_P35610-1_identity</bp:comment>
