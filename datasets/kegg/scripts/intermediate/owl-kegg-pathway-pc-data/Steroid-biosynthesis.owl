 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Cholestenol Delta-isomerase</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Emopamil-binding protein</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">5.3.3.5</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">D8-D7 sterol isomerase</bp:name>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://pathwaycommons.org/pc12/ProteinReference_HPRD_02192_identity</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://www.ctdbase.org/#ref_protein_gene_10682</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://identifiers.org/refseq/NP_006570</bp:comment>
