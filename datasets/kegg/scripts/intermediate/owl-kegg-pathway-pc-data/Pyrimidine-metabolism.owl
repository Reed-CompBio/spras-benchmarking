 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">CDD</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Cytidine aminohydrolase</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">3.5.4.5</bp:name>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://identifiers.org/refseq/NP_001776</bp:comment>
