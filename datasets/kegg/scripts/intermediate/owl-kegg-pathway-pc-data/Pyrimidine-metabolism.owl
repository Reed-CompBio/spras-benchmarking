 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">CMPK1</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">2.7.4.6</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">CMPK</bp:name>
