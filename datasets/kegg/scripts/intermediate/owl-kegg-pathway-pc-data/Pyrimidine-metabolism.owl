 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">TALDO_HUMAN Reviewed; 337 AA.</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://pathwaycommons.org/pc12/ProteinReference_uniprotkb_A0A140VK56_identity</bp:comment>
