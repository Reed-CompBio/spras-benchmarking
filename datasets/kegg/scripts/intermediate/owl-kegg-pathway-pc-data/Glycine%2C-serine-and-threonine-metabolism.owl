 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">CK</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Uridine monophosphate/cytidine monophosphate kinase</bp:name>
