 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">OXDA_HUMAN Reviewed; 347 AA.</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://pathwaycommons.org/pc12/ProteinReference_uniprotkb_P14920_identity</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://identifiers.org/refseq/NP_001908</bp:comment>
