 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Acyl-CoA synthetase short-chain family member 3</bp:name>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://identifiers.org/refseq/NP_078836</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://mirtarbase.mbc.nctu.edu.tw/#ref_79611</bp:comment>
