 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">2,3-diketo-5-methylthio-1-phosphopentane phosphatase</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">ENOPH1</bp:name>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://identifiers.org/uniprot/D6RA00</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://www.ctdbase.org/#ref_protein_gene_58478</bp:comment>
