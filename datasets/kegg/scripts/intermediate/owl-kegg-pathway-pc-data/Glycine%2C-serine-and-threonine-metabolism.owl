 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_7ad4a080317751ae99e5316dc1e43855" />
 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_bbfc61b9272fa87acff3088ed3eceebe" />
