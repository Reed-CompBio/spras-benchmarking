 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_7776a44f59bb374427f3293d952fd0b3" />
 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_ad7486d1251a8b049b34a00f2bd4f7d6" />
 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_1a31ac6c0f51de3aeed344b7d2af9a00" />
