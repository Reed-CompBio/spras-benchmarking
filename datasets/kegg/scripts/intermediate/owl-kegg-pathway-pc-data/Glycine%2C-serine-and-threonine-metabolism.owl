 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_deb009fe8693b4b2d06972f247ec0351" />
 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_97222b07bc71db358fced123cc2fcd0c" />
