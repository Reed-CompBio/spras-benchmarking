 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">2.4.1.-</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">FUT7</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Fucosyltransferase VII</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Fuc-TVII</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Selectin ligand synthase</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">FucT-VII</bp:name>
