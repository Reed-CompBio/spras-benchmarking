 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">SHMT</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Serine methylase</bp:name>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://pathwaycommons.org/pc12/ProteinReference_HPRD_01643_identity</bp:comment>
