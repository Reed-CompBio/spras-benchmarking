 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_3e09f232c6a4246bb53d17d9e26de8b9" />
 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_da446e83aae034791f4c346cca0fa3af" />
