 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">1.3.1.39</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">2.3.1.39</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">[Acyl-carrier-protein] S-malonyltransferase</bp:name>
