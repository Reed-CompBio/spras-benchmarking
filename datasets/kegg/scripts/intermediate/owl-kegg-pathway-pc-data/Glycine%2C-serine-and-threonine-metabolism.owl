<bp:SmallMoleculeReference rdf:about="http://identifiers.org/chebi/CHEBI:5931">
 <bp:xref rdf:resource="http://pathwaycommons.org/pc12/RelationshipXref_chebi_CHEBI_35526_see-also" />
 <bp:xref rdf:resource="http://pathwaycommons.org/pc12/RelationshipXref_chebi_CHEBI_75771_see-also" />
