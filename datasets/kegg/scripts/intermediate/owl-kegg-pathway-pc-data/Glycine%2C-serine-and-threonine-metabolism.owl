 <bp:standardName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Sulfotransferase 2B1</bp:standardName>
 <bp:xref rdf:resource="http://pathwaycommons.org/pc12/RelationshipXref_hgnc_symbol_SULT2B1_identity" />
 <bp:xref rdf:resource="http://pathwaycommons.org/pc12/UnificationXref_uniprot_knowledgebase_O00204" />
 <bp:organism rdf:resource="http://identifiers.org/taxonomy/9606" />
 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">ST2B1_HUMAN</bp:displayName>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">SULT2B1</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Sulfotransferase family 2B member 1</bp:name>
