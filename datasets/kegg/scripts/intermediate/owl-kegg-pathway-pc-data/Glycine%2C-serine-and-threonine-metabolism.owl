<bp:ProteinReference rdf:about="http://identifiers.org/uniprot/Q07864">
 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_aac030a324d758d36d678f4a754e54b0" />
 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_53c268b09c9d37453ba28eae529eb869" />
