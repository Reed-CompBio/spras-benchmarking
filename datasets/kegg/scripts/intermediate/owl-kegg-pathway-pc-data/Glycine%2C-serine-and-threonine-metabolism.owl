 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">ACLY_HUMAN Reviewed; 1101 AA.</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://pathwaycommons.org/pc12/ProteinReference_uniprotkb_P53396_identity</bp:comment>
