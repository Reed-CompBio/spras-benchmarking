 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Oleoyl-[acyl-carrier-protein] hydrolase</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">2.3.1.85</bp:name>
