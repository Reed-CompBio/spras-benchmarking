 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">SIAT6_HUMAN</bp:displayName>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Alpha 2,3-ST 3</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">2.4.99.6</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">ST3GalIII</bp:name>
