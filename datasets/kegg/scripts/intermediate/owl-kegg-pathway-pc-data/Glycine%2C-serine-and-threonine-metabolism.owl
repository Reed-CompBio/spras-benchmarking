 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">SIAT6_HUMAN Reviewed; 375 AA.</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://www.ctdbase.org/#ref_protein_gene_6487</bp:comment>
</bp:ProteinReference>

