<bp:ProteinReference rdf:about="http://identifiers.org/uniprot/P04798">
 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_33d1e44cb940670785c4dc4740bb4a1e" />
