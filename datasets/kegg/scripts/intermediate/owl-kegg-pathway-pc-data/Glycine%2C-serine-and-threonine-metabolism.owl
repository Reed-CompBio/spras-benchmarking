 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">IDHC_HUMAN</bp:displayName>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">1.1.1.42</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Cytosolic NADP-isocitrate dehydrogenase</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">IDP</bp:name>
