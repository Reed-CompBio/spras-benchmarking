 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">4.2.1.59</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">1.1.1.100</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Enoyl-[acyl-carrier-protein] reductase</bp:name>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://identifiers.org/refseq/NP_004095</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://www.ctdbase.org/#ref_protein_gene_2194</bp:comment>
