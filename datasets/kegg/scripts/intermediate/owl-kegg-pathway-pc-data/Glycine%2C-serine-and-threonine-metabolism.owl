 <bp:xref rdf:resource="http://pathwaycommons.org/pc12/UnificationXref_chebi_CHEBI_1438" />
 <bp:xref rdf:resource="http://pathwaycommons.org/pc12/RelationshipXref_chebi_CHEBI_59643_multiple_parent_reference" />
