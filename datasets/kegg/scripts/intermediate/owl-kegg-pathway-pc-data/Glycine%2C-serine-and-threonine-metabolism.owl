 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">GRHPR_HUMAN</bp:displayName>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">GRHPR</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">1.1.1.81</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">1.1.1.79</bp:name>
