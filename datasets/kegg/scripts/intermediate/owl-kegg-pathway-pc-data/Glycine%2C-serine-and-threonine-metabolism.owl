 <bp:standardName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">CMP-N-acetylneuraminate-beta-1,4-galactoside alpha-2,3-sialyltransferase</bp:standardName>
 <bp:xref rdf:resource="http://pathwaycommons.org/pc12/RelationshipXref_hgnc_symbol_ST3GAL3_identity" />
