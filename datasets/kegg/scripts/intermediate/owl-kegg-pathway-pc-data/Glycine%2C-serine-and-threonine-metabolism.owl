 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">SPYA_HUMAN</bp:displayName>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">2.6.1.51</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">SPAT</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">SPT</bp:name>
