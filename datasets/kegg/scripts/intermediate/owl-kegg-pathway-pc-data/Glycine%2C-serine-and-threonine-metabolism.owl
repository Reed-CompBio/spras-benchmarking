 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">DHSO_HUMAN Reviewed; 357 AA.</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://www.ctdbase.org/#ref_protein_gene_6652</bp:comment>
