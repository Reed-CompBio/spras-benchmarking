 <bp:standardName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Fructose-1,6-bisphosphatase 1</bp:standardName>
 <bp:xref rdf:resource="http://pathwaycommons.org/pc12/UnificationXref_uniprot_knowledgebase_P09467" />
