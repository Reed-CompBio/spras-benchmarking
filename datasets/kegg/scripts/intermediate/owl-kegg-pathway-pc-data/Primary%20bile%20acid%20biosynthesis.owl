 <bp:standardName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Primary bile acid biosynthesis</bp:standardName>
 <bp:xref rdf:resource="http://pathwaycommons.org/pc12/UnificationXref_kegg_pathway_hsa00120" />
 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Primary bile acid biosynthesis</bp:displayName>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Primary bile acid...</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Primary bile acid biosynthesis - Homo sapiens (human)</bp:name>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">REPLACED http://identifiers.org/kegg.pathway/hsa00120</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Bile acids are steroid carboxylic acids derived from cholesterol in vertebrates. The primary bile acids, cholic acid and chenodeoxycholic acid, are synthesized in the liver and conjugated with taurine or glycine before secretion via bile into the intestine. The conversion from cholesterol to cholic and chenodeoxycholic acids involves four steps: 1) the initiation of synthesis by 7alpha-hydroxylation of sterol precursors, 2) further modifications to the ring structures, 3) side-chain oxidation and shortening (cleavage) by three carbons, and 4) conjugation of the bile acid with taurine or glycine.</bp:comment>
 <bp:availability rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">This file has been generated by KEGGtranslator version 2.3.0</bp:availability>
 <bp:dataSource rdf:resource="http://pathwaycommons.org/pc12/Provenance_7f56dcb833d61e9a798ef3c386d927b7" />
</bp:Pathway>

