 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">CP8B1_HUMAN</bp:displayName>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">CYP12</bp:name>
