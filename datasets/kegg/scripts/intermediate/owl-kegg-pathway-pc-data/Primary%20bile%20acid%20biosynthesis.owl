 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">CYP8B1</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Cytochrome P450 8B1</bp:name>
