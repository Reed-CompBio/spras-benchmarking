<bp:ProteinReference rdf:about="http://identifiers.org/uniprot/P20711">
 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_49a54b344a0ca113168ea2d303986de0" />
 <bp:entityFeature rdf:resource="http://pathwaycommons.org/pc12/ModificationFeature_f4b0100992e31fa46b280a2d0de1ef18" />
