 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Protein Fig-1</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">LAO</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">IL4-induced protein 1</bp:name>
