 <bp:standardName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Catalase</bp:standardName>
 <bp:xref rdf:resource="http://pathwaycommons.org/pc12/UnificationXref_uniprot_knowledgebase_P04040" />
