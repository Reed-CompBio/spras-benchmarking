 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">OXLA_HUMAN</bp:displayName>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">LAAO</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">IL4I1</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Interleukin-4-induced protein 1</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">1.4.3.2</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Protein Fig-1</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">LAO</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">IL4-induced protein 1</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">FIG1</bp:name>
