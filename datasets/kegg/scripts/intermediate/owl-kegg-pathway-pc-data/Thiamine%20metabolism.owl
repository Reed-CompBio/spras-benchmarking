 <bp:standardName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Cysteine desulfurase, mitochondrial</bp:standardName>
 <bp:xref rdf:resource="http://pathwaycommons.org/pc12/UnificationXref_uniprot_knowledgebase_Q9Y697" />
 <bp:xref rdf:resource="http://pathwaycommons.org/pc12/RelationshipXref_hgnc_symbol_NFS1_identity" />
